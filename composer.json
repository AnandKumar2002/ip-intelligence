{
    "name": "parvion/ip-intelligence",
    "description": "A high-performance Laravel package for IP intelligence, geolocation, and device detection.",
    "type": "library",
    "require": {
        "php": "^8.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Parvion\\IpIntelligence\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Parvion\\IpIntelligence\\IpIntelligenceServiceProvider"
            ],
            "aliases": {
                "IpIntelligence": "Parvion\\IpIntelligence\\Facades\\IpIntelligence"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
